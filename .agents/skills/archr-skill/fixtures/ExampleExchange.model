<?xml version="1.0" encoding="UTF-8"?>
<model xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xmlns="http://www.archimatetool.com/archimate"
       name="Example ArchiMate 3.2 Model"
       identifier="example-model"
       version="3.2">
  <elements>
    <element id="ex-business-actor" type="BusinessActor">
      <name>Customer</name>
      <documentation>Main business actor for insurance company</documentation>
    </element>
    <element id="ex-business-function" type="BusinessFunction">
      <name>Process Claim</name>
      <documentation>Handle insurance claims from customers</documentation>
    </element>
    <element id="ex-application-component" type="ApplicationComponent">
      <name>Claims Processing System</name>
      <documentation>Core application for processing insurance claims</documentation>
    </element>
    <element id="ex-data-object" type="DataObject">
      <name>Policy Document</name>
      <documentation>Digital version of customer policy documents</documentation>
    </element>
    <element id="ex-technology-node" type="Node">
      <name>Application Server</name>
      <documentation>Server running the Claims Processing System</documentation>
    </element>
  </elements>
  <relationships>
    <relationship id="ex-rel-1" type="Assignment">
      <source idref="ex-business-actor"/>
      <target idref="ex-business-function"/>
    </relationship>
    <relationship id="ex-rel-2" type="Realization">
      <source idref="ex-application-component"/>
      <target idref="ex-business-function"/>
    </relationship>
    <relationship id="ex-rel-3" type="Access">
      <source idref="ex-application-component"/>
      <target idref="ex-data-object"/>
    </relationship>
    <relationship id="ex-rel-4" type="Serving">
      <source idref="ex-application-component"/>
      <target idref="ex-business-function"/>
    </relationship>
    <relationship id="ex-rel-5" type="Association">
      <source idref="ex-technology-node"/>
      <target idref="ex-application-component"/>
    </relationship>
  </relationships>
</model>
